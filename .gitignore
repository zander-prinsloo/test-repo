# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# PyCharm
.idea/

# VS Code
.vscode/

# Environment variables
.env
.env.local

# Data files (large files should not be committed)
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json
data/processed/*.csv
data/processed/*.xlsx
data/external/*.csv
data/external/*.xlsx

# Exclude all data files by default, but allow README files
data/**/*
!data/**/README.md
!data/**/.gitkeep

# Model files
*.pkl
*.h5
*.pt
*.pth
*.onnx

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

